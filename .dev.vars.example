# ── Required ──────────────────────────────────────────────────────────────────
# Your supermemory API key: this is where the brain reads and writes memory.
# Get one at https://console.supermemory.ai
SUPERMEMORY_API_KEY=""

# A provider key, or your own proxy's key when MODEL_BASE_URL is set below.
# Without a custom URL, the brain detects Anthropic, OpenAI, Google, xAI and
# OpenRouter keys by prefix. An OpenRouter key (sk-or-) reaches every provider.
MODEL_API_KEY=""

# Optional: your OpenAI-compatible proxy's API base URL, including /v1 if needed
# (e.g. https://llm-proxy.example.com/v1). Leave blank for native providers or
# OpenRouter. With a URL set, MODEL_API_KEY accepts any proxy key format.
# These uncommented entries expose the fields in Deploy to Cloudflare; they
# are stored as secrets and aren't overwritten by later Wrangler deployments.
MODEL_BASE_URL=""
# Optional: exact model ID/alias for ALL brain calls (main, triage, research).
# Leave blank to send the selected model's native API ID, without a vendor prefix.
MODEL_ID=""

# Or set providers explicitly, e.g. to give it more than one:
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""
# XAI_API_KEY=""
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL=""
# Optional: point the OpenRouter-compatible path at another OpenAI-compatible
# router instead of openrouter.ai — e.g. FreeRouter:
# OPENROUTER_BASE_URL="https://api.freerouter.com/v1"
# with OPENROUTER_API_KEY set to your router key. Model ids stay vendor/model.

# ── Optional ──────────────────────────────────────────────────────────────────
# Sandbox tools (shell, git, files). On Workers Paid, with the paid block in
# wrangler.jsonc enabled and CONTAINER_SANDBOX set to "on", they run on a
# Cloudflare container (local dev then needs Docker). On the free plan, or if
# you prefer it, set a Daytona key:
# uncomment this, or add it later with `wrangler secret put DAYTONA_API_KEY`.
# DAYTONA_API_KEY=""

# Web search and page reading use Firecrawl's free keyless tier by default
# (1,000 credits a month). Set a key for more, or a context.dev key to use that.
# FIRECRAWL_API_KEY=""
# CONTEXT_DEV_API_KEY=""
