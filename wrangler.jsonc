{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sudopedia",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "sudopedia.sudosapient.dev",
			"custom_domain": true,
			"zone_name": "sudosapient.dev"
		}
	],
	"main": "src/worker.ts",
	"compatibility_date": "2025-06-22",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
		"enable_ctx_exports"
	],
	"minify": true,
	// Preserve dashboard-configured variables across code deployments. Custom
	// model inputs are declared in .dev.vars.example as secrets, not blank vars
	// here, so committed defaults cannot overwrite the deployment's endpoint.
	"keep_vars": true,
	"build": {
		"command": "bun run build:web",
		"watch_dir": ["src", "web"]
	},
	"assets": {
		"directory": "./dist/web",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/mcp",
			"/mcp/*",
			"/brain/*",
			"/slack/*",
			"/auth/*",
			"/setup",
			"/setup/*",
			"/health"
		]
	},
	"vars": {
		"PUBLIC_URL": "https://sudopedia.sudosapient.dev",
		"EXTERNAL_PUBLIC_URL": "https://sudopedia.sudosapient.dev",
		// Default-off creation gate: enable separately after backend/schema verification.
		// Existing credentials and their exact permissions remain usable with this off.
		"EXTERNAL_EMPLOYEE_CREATION_ENABLED": "off",
		// "on" once the Workers Paid block below is enabled: sandbox tools then
		// run on a Cloudflare container.
		"CONTAINER_SANDBOX": "off",
		// The sandbox SDK's RPC transport; artifact downloads stream over it.
		"SANDBOX_TRANSPORT": "rpc"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sudopedia",
			"database_id": "c0879ac6-88af-471a-93dc-8c2e3f358d22",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BRAIN_KV",
			"id": "acd50be730ce48e28835a0ff80aae82e"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "COMPANY_BRAIN_AGENT",
				"class_name": "CompanyBrainAgent"
			},
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CompanyBrainAgent"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Sandbox"
			]
		}
	],
	// ── Workers Paid ($5/mo) ─────────────────────────────────────────────────
	// The brain runs on the free plan. On Workers Paid, uncomment this block
	// and set CONTAINER_SANDBOX to "on" above to give it a built-in container
	// sandbox (shell, git, Python). Without it, sandbox tools use Daytona when
	// DAYTONA_API_KEY is set.
	//
	// "containers": [
	// 	{
	// 		"class_name": "Sandbox",
	// 		"image": "./sandbox/Dockerfile",
	// 		"instance_type": "basic",
	// 		"max_instances": 10
	// 	}
	// ],
	"unsafe": {
		"bindings": [
			{
				"type": "ratelimit",
				"name": "EXTERNAL_RATE_LIMITER",
				"namespace_id": "1103",
				"simple": { "limit": 60, "period": 60 }
			},
			{
				"type": "ratelimit",
				"name": "EXTERNAL_MANAGEMENT_RATE_LIMITER",
				"namespace_id": "1104",
				"simple": { "limit": 10, "period": 60 }
			},
			{
				"type": "ratelimit",
				"name": "GMAIL_FETCH_RATE_LIMITER",
				"namespace_id": "1101",
				"simple": {
					"limit": 150,
					"period": 10
				}
			},
			{
				"type": "ratelimit",
				"name": "GRANOLA_FETCH_RATE_LIMITER",
				"namespace_id": "1102",
				"simple": {
					"limit": 25,
					"period": 10
				}
			}
		]
	}
}
